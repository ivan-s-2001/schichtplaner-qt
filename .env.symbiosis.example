# Copy to .env.symbiosis and replace every generated secret before production.

POSTGRES_PASSWORD=outline-local-password
POSTGRES_PORT=5432

OUTLINE_URL=http://localhost:3000
OUTLINE_PORT=3000

SCHEDULE_URL=http://localhost:41873
SCHEDULE_PORT=41873

# The same value is passed to Outline and Schichtplaner.
SCHEDULE_SSO_SECRET=replace-with-a-random-64-character-secret

# NextAuth session signing secret for Schichtplaner.
NEXTAUTH_SECRET=replace-with-another-random-64-character-secret

# Outline also reads these values through this env file.
SECRET_KEY=replace-with-64-hex-characters
UTILS_SECRET=replace-with-a-random-64-character-secret
DEFAULT_LANGUAGE=ru_RU

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=schichtplaner
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
