generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "schedule"]
}

// Read-only compatibility view over public.users. No personal data is stored
// in the schedule schema.
model User {
  id            String    @id @db.Uuid
  email         String?
  passwordHash  String?
  firstName     String
  lastName      String
  patronymic    String?
  nickname      String?
  phone         String?
  profileImage  String?
  locale        String
  emailVerified DateTime?
  createdAt     DateTime
  updatedAt     DateTime

  memberships   OrganizationMember[]
  notes         EmployeeNote[]       @relation("subject")
  authoredNotes EmployeeNote[]       @relation("author")
  bookings      Booking[]
  timeRecords   TimeRecord[]
  absences      Absence[]
  modRequests   ModRequest[]
  liveLogs      LiveLog[]
  dayOffs       ScheduleDayOff[]

  @@map("users")
  @@schema("schedule")
}

// Read-only view over the single Outline workspace. It is retained only as a
// compatibility projection for existing scheduling code, not as stored data.
model Organization {
  id                 String             @id @db.Uuid
  name               String
  address            String?
  nameFormat         NameFormat
  scheduleVisibility ScheduleVisibility
  createdAt          DateTime
  updatedAt          DateTime
  deletedAt          DateTime?

  members           OrganizationMember[]
  branches          Branch[]
  divisions         Division[]
  schedules         Schedule[]
  timeCategories    TimeCategory[]
  timeSettings      TimeSettings?
  absenceCategories AbsenceCategory[]
  holidays          Holiday[]

  @@map("organizations")
  @@schema("schedule")
}

// Read-only view over public.users.
model OrganizationMember {
  id              String   @id @db.Uuid
  organizationId  String   @db.Uuid
  userId          String   @db.Uuid
  role            OrgRole
  isActive        Boolean
  isActivated     Boolean
  activationToken String?
  joinedAt        DateTime

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
  @@schema("schedule")
}

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE

  @@schema("schedule")
}

enum NameFormat {
  LASTNAME_FIRSTNAME
  FIRSTNAME_LASTNAME
  LASTNAME
  FIRSTNAME
  NICKNAME

  @@schema("schedule")
}

enum ScheduleVisibility {
  ALL
  OWN_ONLY

  @@schema("schedule")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  name           String
  address        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  schedules    Schedule[]

  @@map("branches")
  @@schema("schedule")
}

// Read-only view over public.groups. Group UUID is the department UUID.
model Division {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  title          String
  description    String?
  color          String
  isSystem       Boolean
  createdAt      DateTime
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id])
  members      DivisionMember[]
  schedules    Schedule[]
  shifts       Shift[]

  @@map("divisions")
  @@schema("schedule")
}

// Read-only view over public.group_users.
model DivisionMember {
  divisionId String @db.Uuid
  userId     String @db.Uuid

  division Division @relation(fields: [divisionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([divisionId, userId])
  @@map("division_members")
  @@schema("schedule")
}

model Schedule {
  id             String         @id @default(cuid())
  organizationId String         @db.Uuid
  divisionId     String?        @db.Uuid
  branchId       String?
  weekNumber     Int
  year           Int
  isPublic       Boolean        @default(false)
  settingsLayout ScheduleLayout @default(LAYOUT_1)
  showTitle      Boolean        @default(true)
  showPauses     Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  division     Division?    @relation(fields: [divisionId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  shifts       Shift[]
  liveSession  LiveSession?
  dayNotes     ScheduleDayNote[]
  dayOffs      ScheduleDayOff[]

  @@unique([organizationId, divisionId, weekNumber, year, branchId])
  @@index([organizationId, divisionId, year, weekNumber])
  @@map("schedules")
  @@schema("schedule")
}

enum ScheduleLayout {
  LAYOUT_1
  LAYOUT_2

  @@schema("schedule")
}

model Shift {
  id                  String      @id @default(cuid())
  scheduleId          String
  divisionId          String?     @db.Uuid
  dayOfWeek           Int
  shiftFrom           String
  shiftTo             String
  maxEmployees        Int         @default(1)
  pauseOption         PauseOption @default(PER_HOUR)
  pauseValue          Int         @default(0)
  title               String?
  description         String?
  poolTemplateCode    String?
  poolLabel           String?
  poolColor           String?
  poolTextColor       String?
  poolDescription     String?
  createdAt           DateTime    @default(now())
  deletedAt           DateTime?

  schedule    Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  division    Division?    @relation(fields: [divisionId], references: [id])
  bookings    Booking[]
  modRequests ModRequest[]

  @@index([poolTemplateCode])
  @@map("shifts")
  @@schema("schedule")
}

enum PauseOption {
  PER_HOUR
  PER_SHIFT

  @@schema("schedule")
}

model Booking {
  id                    String   @id @default(cuid())
  shiftId               String
  userId                String   @db.Uuid
  bookedAt              DateTime @default(now())
  bookedBy              String?  @db.Uuid
  overtimeMinutes       Int      @default(0)
  overtimeBeforeMinutes Int      @default(0)
  overtimeAfterMinutes  Int      @default(0)

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([shiftId, userId])
  @@map("bookings")
  @@schema("schedule")
}

model ModRequest {
  id       String       @id @default(cuid())
  shiftId  String
  userId   String       @db.Uuid
  state    RequestState @default(OPEN)
  note     String?
  deadline DateTime?
  sentAt   DateTime     @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([shiftId, userId])
  @@map("mod_requests")
  @@schema("schedule")
}

enum RequestState {
  OPEN
  ACCEPTED
  DECLINED

  @@schema("schedule")
}

model LiveSession {
  id           String   @id @default(cuid())
  scheduleId   String   @unique
  isActive     Boolean  @default(true)
  deadline     DateTime?
  autoStop     Boolean  @default(false)
  allowExceeds Boolean  @default(false)
  bookRequests Boolean  @default(false)
  startedAt    DateTime @default(now())

  schedule Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  days     LiveDay[]
  logs     LiveLog[]

  @@map("live_sessions")
  @@schema("schedule")
}

model LiveDay {
  id            String  @id @default(cuid())
  liveSessionId String
  dayOfWeek     Int
  enabled       Boolean @default(true)

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, dayOfWeek])
  @@map("live_days")
  @@schema("schedule")
}

model LiveLog {
  id            String     @id @default(cuid())
  liveSessionId String
  shiftId       String
  userId        String     @db.Uuid
  action        LiveAction
  loggedAt      DateTime   @default(now())

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@map("live_logs")
  @@schema("schedule")
}

enum LiveAction {
  BOOK
  UNBOOK

  @@schema("schedule")
}

model TimeRecord {
  id              String         @id @default(cuid())
  userId          String         @db.Uuid
  date            DateTime       @db.Date
  timeFrom        String?
  timeTo          String?
  durationHours   Int?
  durationMinutes Int?
  type            TimeRecordType
  categoryId      String?
  comment         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  category TimeCategory? @relation(fields: [categoryId], references: [id])

  @@map("time_records")
  @@schema("schedule")
}

enum TimeRecordType {
  MANUAL
  WATCH
  MANUAL_DURATION

  @@schema("schedule")
}

model TimeCategory {
  id             String  @id @default(cuid())
  organizationId String  @db.Uuid
  name           String
  enabled        Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])
  records      TimeRecord[]

  @@map("time_categories")
  @@schema("schedule")
}

model TimeSettings {
  id               String    @id @default(cuid())
  organizationId   String    @unique @db.Uuid
  trackingOptions  String?
  watchAutoStop    Boolean   @default(false)
  warningsEnabled  Boolean   @default(false)
  warningsMaxHours Int       @default(10)
  whoCanUse        WhoCanUse @default(ALL)
  useCategories    Boolean   @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("time_settings")
  @@schema("schedule")
}

enum WhoCanUse {
  ALL
  CHOOSE

  @@schema("schedule")
}

model Absence {
  id         String        @id @default(cuid())
  userId     String        @db.Uuid
  categoryId String
  dateFrom   DateTime      @db.Date
  dateTo     DateTime      @db.Date
  note       String?
  status     AbsenceStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  user     User            @relation(fields: [userId], references: [id])
  category AbsenceCategory @relation(fields: [categoryId], references: [id])

  @@map("absences")
  @@schema("schedule")
}

enum AbsenceStatus {
  PENDING
  APPROVED
  DECLINED

  @@schema("schedule")
}

model AbsenceCategory {
  id             String  @id @default(cuid())
  organizationId String  @db.Uuid
  name           String
  color          String  @default("#ef4444")
  isPaid         Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])
  absences     Absence[]

  @@map("absence_categories")
  @@schema("schedule")
}

model Holiday {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  name           String
  date           DateTime @db.Date
  country        String   @default("DE")
  state          String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("holidays")
  @@schema("schedule")
}

model EmployeeNote {
  id        String   @id @default(cuid())
  subjectId String   @db.Uuid
  authorId  String   @db.Uuid
  text      String
  createdAt DateTime @default(now())

  subject User @relation("subject", fields: [subjectId], references: [id])
  author  User @relation("author", fields: [authorId], references: [id])

  @@map("employee_notes")
  @@schema("schedule")
}

model ScheduleDayNote {
  id        String   @id
  scheduleId String
  dayOfWeek Int
  note      String
  status    String   @default("PLANNED")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, dayOfWeek])
  @@map("schedule_day_notes")
  @@schema("schedule")
}

model ScheduleDayOff {
  id        String   @id
  scheduleId String
  userId    String   @db.Uuid
  dayOfWeek Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([scheduleId, userId, dayOfWeek])
  @@index([userId])
  @@map("schedule_day_offs")
  @@schema("schedule")
}

model ShiftPoolTemplate {
  id             String   @id
  organizationId String   @db.Uuid
  code           String
  name           String
  shiftFrom      String
  shiftTo        String
  color          String
  textColor      String   @default("#111827")
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, sortOrder])
  @@map("shift_pool_templates")
  @@schema("schedule")
}
